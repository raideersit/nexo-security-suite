<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Arnes del analisis en tiempo real: fuente de cambios y motor falsos (portable), mas una
         prueba con FileSystemWatcher real sobre una carpeta temporal. No requiere ClamAV. -->
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Nexo.RealTime.Demo</RootNamespace>
    <AssemblyName>nexo-realtime-demo</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Nexo.Modules.Threats\Nexo.Modules.Threats.csproj" />
  </ItemGroup>

</Project>
