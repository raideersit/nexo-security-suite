<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Arnes de las reglas de vulnerabilidades del sistema (portable): cuentas, politica de contrasenas, inicio automatico. -->
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Nexo.Vuln.Demo</RootNamespace>
    <AssemblyName>nexo-vuln-demo</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Respuesta REAL de NVD (consultada el 2026-11-07) para WinRAR 7.01: los datos de prueba no se inventan. -->
    <EmbeddedResource Include="Datos\nvd-winrar-7.01.json" LogicalName="nvd-winrar-7.01.json" />
    <EmbeddedResource Include="Datos\nvd-nodejs-24.15.0.json" LogicalName="nvd-nodejs-24.15.0.json" />
    <EmbeddedResource Include="Datos\nvd-java-8u401.json" LogicalName="nvd-java-8u401.json" />
    <!-- Evento 7045 REAL de este equipo (servicio de Chrome), con el nombre del equipo cambiado. -->
    <EmbeddedResource Include="Datos\evento-7045-real.xml" LogicalName="evento-7045-real.xml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Nexo.Modules.Threats\Nexo.Modules.Threats.csproj" />
  </ItemGroup>

</Project>
