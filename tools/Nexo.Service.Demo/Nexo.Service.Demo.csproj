<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Arnes del servicio: levanta el NexoWorker en el mismo proceso (sin instalarlo, sin
         LocalSystem), con un vault temporal y un pipe de nombre unico. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Nexo.Service.Demo</RootNamespace>
    <AssemblyName>nexo-service-demo</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Nexo.Service\Nexo.Service.csproj" />
  </ItemGroup>

</Project>
