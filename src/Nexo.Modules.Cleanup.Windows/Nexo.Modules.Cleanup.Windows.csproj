<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Lo especifico de Windows del modulo de limpieza vive aparte para que
         Nexo.Modules.Cleanup siga compilando y probandose fuera de Windows. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Nexo.Modules.Cleanup.Windows</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- WMI (S.M.A.R.T.). Es codigo administrado, no P/Invoke, asi que puede
         vivir aqui y no en Nexo.Native. -->
    <PackageReference Include="System.Management" Version="8.0.0" />
    <!-- EventLogReader (impacto de arranque, Diagnostics-Performance) no viene en el framework base. -->
    <PackageReference Include="System.Diagnostics.EventLog" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nexo.Modules.Cleanup\Nexo.Modules.Cleanup.csproj" />
    <ProjectReference Include="..\Nexo.Native\Nexo.Native.csproj" />
  </ItemGroup>

</Project>
