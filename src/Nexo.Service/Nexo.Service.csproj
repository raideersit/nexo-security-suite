<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Servicio de Windows (Salida 0, §2). Mismo ejecutable como servicio o en consola:
         en consola sirve para probarlo sin instalar nada ni usar LocalSystem. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Nexo.Service</RootNamespace>
    <AssemblyName>nexo-service</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nexo.Ipc\Nexo.Ipc.csproj" />
    <ProjectReference Include="..\Nexo.Modules.Threats.Windows\Nexo.Modules.Threats.Windows.csproj" />
    <ProjectReference Include="..\Nexo.Modules.Cleanup.Windows\Nexo.Modules.Cleanup.Windows.csproj" />
    <ProjectReference Include="..\Nexo.Reports\Nexo.Reports.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="nexo-service-demo" />
    <InternalsVisibleTo Include="nexo-tray-demo" />
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
