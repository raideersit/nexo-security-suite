{
  "manifest_version": 3,
  "name": "Nexo: autocompletado",
  "version": "0.1.0",
  "description": "Rellena usuario y contraseña desde la bóveda de Nexo, solo en el sitio correcto y solo cuando lo pides.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["nativeMessaging", "activeTab", "scripting", "storage"],
  "background": { "service_worker": "fondo.js", "type": "module" },
  "action": { "default_popup": "ventana.html", "default_title": "Nexo: rellenar usuario y contraseña" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+N" }, "description": "Abrir Nexo para rellenar" }
  },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
