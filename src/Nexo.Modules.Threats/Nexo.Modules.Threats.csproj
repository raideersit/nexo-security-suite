<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0 y no net8.0-windows a proposito, igual que Nexo.Modules.Cleanup:
         la logica de decision (que se puede bloquear, que se rechaza, el token)
         queda ejecutable y probable fuera de Windows contra un almacen en
         memoria. Lo que habla con el Firewall de Windows vive en
         Nexo.Modules.Threats.Windows detras de IAlmacenDeFirewall. -->
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Nexo.Modules.Threats</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lista oficial de terminaciones de IANA (https://data.iana.org/TLD/tlds-alpha-by-domain.txt, version 2026110900): sirve para
         reconocer enlaces escritos sin «http://» en un mensaje. Se actualiza a mano de vez en cuando. -->
    <EmbeddedResource Include="Enlaces\Datos\tlds-iana.txt" LogicalName="tlds-iana.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lector de codigos QR (Apache-2.0, gratuito, sin dependencias). Solo recibe pixeles: abrir la imagen lo hace quien lo usa. -->
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nexo.Reports\Nexo.Reports.csproj" />
  </ItemGroup>

</Project>
