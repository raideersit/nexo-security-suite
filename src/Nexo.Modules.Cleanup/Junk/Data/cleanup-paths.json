{
  "version": 1,
  "_comentario": [
    "Catalogo de rutas limpiables de Windows 10/11.",
    "Esta es la lista de lo que Nexo tiene PERMISO para borrar. Revisala entera",
    "antes de confiar en ella. Nada fuera de aqui se toca nunca.",
    "riesgo bajo  = activo por defecto, sin consecuencias visibles",
    "riesgo medio = desactivado por defecto, efecto perceptible (cierra sesiones, etc.)",
    "riesgo alto  = nunca se activa solo, puede romper funciones de Windows"
  ],

  "reglas": [
    {
      "id": "temp-usuario",
      "categoria": "temporales",
      "nombre": "Archivos temporales del usuario",
      "base": "localAppData",
      "subruta": "Temp",
      "patron": "*",
      "recursivo": true,
      "requiereAdmin": false,
      "riesgo": "bajo",
      "antiguedadMinimaDias": 1,
      "excluir": ["*.lock", "*.pid"],
      "nota": "Equivale a %TEMP%. Los archivos en uso quedan bloqueados y se omiten solos."
    },
    {
      "id": "crash-dumps-usuario",
      "categoria": "volcados",
      "nombre": "Volcados de bloqueo de aplicaciones",
      "base": "localAppData",
      "subruta": "CrashDumps",
      "patron": "*.dmp",
      "recursivo": false,
      "requiereAdmin": false,
      "riesgo": "bajo",
      "antiguedadMinimaDias": 7,
      "nota": "Solo utiles si estas depurando un cuelgue concreto."
    },
    {
      "id": "inetcache",
      "categoria": "cache-navegadores",
      "nombre": "Cache de Internet Explorer / WebView",
      "base": "localAppData",
      "subruta": "Microsoft\\Windows\\INetCache",
      "patron": "*",
      "recursivo": true,
      "requiereAdmin": false,
      "riesgo": "bajo",
      "antiguedadMinimaDias": 1,
      "nota": "Lo sigue usando cualquier app con control WebView embebido."
    },
    {
      "id": "thumbcache",
      "categoria": "miniaturas",
      "nombre": "Cache de miniaturas del Explorador",
      "base": "localAppData",
      "subruta": "Microsoft\\Windows\\Explorer",
      "patron": "thumbcache_*.db",
      "recursivo": false,
      "requiereAdmin": false,
      "riesgo": "bajo",
      "antiguedadMinimaDias": 1,
      "nota": "Se regenera solo. La primera vez que abras una carpeta con muchas imagenes ira algo mas lenta."
    },
    {
      "id": "wer-usuario",
      "categoria": "logs-windows",
      "nombre": "Informes de error de Windows (usuario)",
      "base": "localAppData",
      "subruta": "Microsoft\\Windows\\WER",
      "patron": "*",
      "recursivo": true,
      "requiereAdmin": false,
      "riesgo": "bajo",
      "antiguedadMinimaDias": 7,
      "nota": "ReportArchive y ReportQueue. No afecta al Visor de eventos."
    },
    {
      "id": "shader-cache-nvidia",
      "categoria": "cache-gpu",
      "nombre": "Cache de shaders NVIDIA",
      "base": "localAppData",
      "subruta": "NVIDIA\\DXCache",
      "patron": "*",
      "recursivo": true,
      "requiereAdmin": false,
      "riesgo": "bajo",
      "antiguedadMinimaDias": 30,
      "nota": "Se regenera. El primer arranque de cada juego tardara algo mas."
    },
    {
      "id": "d3d-cache",
      "categoria": "cache-gpu",
      "nombre": "Cache de shaders DirectX",
      "base": "localAppData",
      "subruta": "D3DSCache",
      "patron": "*",
      "recursivo": true,
      "requiereAdmin": false,
      "riesgo": "bajo",
      "antiguedadMinimaDias": 30,
      "nota": "Igual que el anterior: se regenera solo."
    },

    {
      "id": "chrome-cache",
      "categoria": "cache-navegadores",
      "nombre": "Cache de Google Chrome",
      "base": "localAppData",
      "subruta": "Google\\Chrome\\User Data\\*\\Cache\\Cache_Data",
      "patron": "*",
      "recursivo": true,
      "requiereAdmin": false,
      "riesgo": "bajo",
      "antiguedadMinimaDias": 1,
      "nota": "El comodin cubre Default y Profile 1, 2, 3... Cierra Chrome antes o los archivos quedaran bloqueados."
    },
    {
      "id": "chrome-code-cache",
      "categoria": "cache-navegadores",
      "nombre": "Cache de codigo de Chrome",
      "base": "localAppData",
      "subruta": "Google\\Chrome\\User Data\\*\\Code Cache",
      "patron": "*",
      "recursivo": true,
      "requiereAdmin": false,
      "riesgo": "bajo",
      "antiguedadMinimaDias": 1,
      "nota": "JavaScript y WASM compilados. Se regenera."
    },
    {
      "id": "edge-cache",
      "categoria": "cache-navegadores",
      "nombre": "Cache de Microsoft Edge",
      "base": "localAppData",
      "subruta": "Microsoft\\Edge\\User Data\\*\\Cache\\Cache_Data",
      "patron": "*",
      "recursivo": true,
      "requiereAdmin": false,
      "riesgo": "bajo",
      "antiguedadMinimaDias": 1,
      "nota": "Mismo formato que Chrome; Edge comparte el motor."
    },
    {
      "id": "firefox-cache",
      "categoria": "cache-navegadores",
      "nombre": "Cache de Mozilla Firefox",
      "base": "localAppData",
      "subruta": "Mozilla\\Firefox\\Profiles\\*\\cache2",
      "patron": "*",
      "recursivo": true,
      "requiereAdmin": false,
      "riesgo": "bajo",
      "antiguedadMinimaDias": 1,
      "nota": "Firefox separa cache (LocalAppData) de perfil (RoamingAppData); esto es solo cache."
    },

    {
      "id": "chrome-cookies",
      "categoria": "cookies",
      "nombre": "Cookies de Chrome",
      "base": "localAppData",
      "subruta": "Google\\Chrome\\User Data\\*\\Network",
      "patron": "Cookies",
      "recursivo": false,
      "requiereAdmin": false,
      "riesgo": "medio",
      "antiguedadMinimaDias": 0,
      "nota": "RIESGO MEDIO: te cerrara la sesion en TODOS los sitios. Es una base SQLite; borrarla es todo o nada. Desactivado por defecto."
    },
    {
      "id": "chrome-historial",
      "categoria": "historial",
      "nombre": "Historial de navegacion de Chrome",
      "base": "localAppData",
      "subruta": "Google\\Chrome\\User Data\\*",
      "patron": "History",
      "recursivo": false,
      "requiereAdmin": false,
      "riesgo": "medio",
      "antiguedadMinimaDias": 0,
      "nota": "RIESGO MEDIO: pierdes historial y sugerencias de la barra de direcciones. Desactivado por defecto."
    },
    {
      "id": "recientes",
      "categoria": "historial",
      "nombre": "Documentos recientes del Explorador",
      "base": "roamingAppData",
      "subruta": "Microsoft\\Windows\\Recent",
      "patron": "*.lnk",
      "recursivo": false,
      "requiereAdmin": false,
      "riesgo": "medio",
      "antiguedadMinimaDias": 0,
      "nota": "RIESGO MEDIO: vacia 'Acceso rapido' y las listas de saltos. Solo accesos directos, nunca los documentos."
    },

    {
      "id": "temp-sistema",
      "categoria": "temporales",
      "nombre": "Archivos temporales del sistema",
      "base": "systemRoot",
      "subruta": "Temp",
      "patron": "*",
      "recursivo": true,
      "requiereAdmin": true,
      "riesgo": "bajo",
      "antiguedadMinimaDias": 7,
      "nota": "REQUIERE ADMIN. Lo usan los instaladores y los servicios; 7 dias de margen para no pisar una instalacion en curso."
    },
    {
      "id": "windows-update-download",
      "categoria": "actualizaciones",
      "nombre": "Descargas de Windows Update",
      "base": "systemRoot",
      "subruta": "SoftwareDistribution\\Download",
      "patron": "*",
      "recursivo": true,
      "requiereAdmin": true,
      "riesgo": "medio",
      "antiguedadMinimaDias": 14,
      "nota": "REQUIERE ADMIN y detener el servicio wuauserv antes. Si hay una actualizacion a medio instalar, tendra que descargarla de nuevo."
    },
    {
      "id": "cbs-logs",
      "categoria": "logs-windows",
      "nombre": "Registros de Component Based Servicing",
      "base": "systemRoot",
      "subruta": "Logs\\CBS",
      "patron": "*.log",
      "recursivo": false,
      "requiereAdmin": true,
      "riesgo": "bajo",
      "antiguedadMinimaDias": 30,
      "nota": "REQUIERE ADMIN. Llegan a varios GB. Solo se necesitan para diagnosticar un fallo de DISM o SFC."
    },
    {
      "id": "minidumps",
      "categoria": "volcados",
      "nombre": "Minivolcados de pantallazo azul",
      "base": "systemRoot",
      "subruta": "Minidump",
      "patron": "*.dmp",
      "recursivo": false,
      "requiereAdmin": true,
      "riesgo": "medio",
      "antiguedadMinimaDias": 30,
      "nota": "REQUIERE ADMIN. RIESGO MEDIO: si estas investigando pantallazos azules, esto es justo lo que necesitas conservar."
    },
    {
      "id": "wer-sistema",
      "categoria": "logs-windows",
      "nombre": "Informes de error de Windows (todos los usuarios)",
      "base": "programData",
      "subruta": "Microsoft\\Windows\\WER",
      "patron": "*",
      "recursivo": true,
      "requiereAdmin": true,
      "riesgo": "bajo",
      "antiguedadMinimaDias": 14,
      "nota": "REQUIERE ADMIN."
    },

    {
      "id": "corpus-prueba",
      "categoria": "temporales",
      "nombre": "Corpus sintetico de pruebas",
      "base": "raizDePrueba",
      "subruta": "temp",
      "patron": "*",
      "recursivo": true,
      "requiereAdmin": false,
      "riesgo": "bajo",
      "antiguedadMinimaDias": 0,
      "nota": "Solo para el arnes de aceptacion. No existe en un equipo real."
    },
    {
      "id": "corpus-prueba-cache",
      "categoria": "cache-navegadores",
      "nombre": "Cache sintetica de pruebas",
      "base": "raizDePrueba",
      "subruta": "cache\\*\\Cache_Data",
      "patron": "*",
      "recursivo": true,
      "requiereAdmin": false,
      "riesgo": "bajo",
