<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Lo especifico de Windows del modulo de amenazas vive aparte para que
         Nexo.Modules.Threats siga compilando y probandose fuera de Windows. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Nexo.Modules.Threats.Windows</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nexo.Modules.Threats\Nexo.Modules.Threats.csproj" />
    <ProjectReference Include="..\Nexo.Native\Nexo.Native.csproj" />
    <!-- EventLogReader (lectura del registro de Seguridad) no viene en el framework base. Paquete oficial de Microsoft. -->
    <PackageReference Include="System.Diagnostics.EventLog" Version="8.0.1" />
  </ItemGroup>

</Project>
