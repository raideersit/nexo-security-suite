<classic:ClassicWindow xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:classic="clr-namespace:Classic.Avalonia.Theme;assembly=Classic.Avalonia.Theme"
                       xmlns:cc="clr-namespace:Classic.CommonControls;assembly=Classic.CommonControls.Avalonia"
                       xmlns:local="clr-namespace:Nexo.Ui.Desktop"
                       x:Class="Nexo.Ui.Desktop.MainWindow"
                       x:DataType="local:VentanaPrincipalModelo"
                       Title="Nexo Security Suite"
                       Width="900" Height="620" MinWidth="640" MinHeight="460"
                       WindowStartupLocation="CenterScreen">

    <classic:ClassicWindow.Styles>
        <Style Selector="HeaderedContentControl">
            <Setter Property="Padding" Value="10,12,10,10" />
        </Style>
        <Style Selector="TextBlock.pendiente">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="16" />
        </Style>
    </classic:ClassicWindow.Styles>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Archivo">
                <MenuItem Header="_Salir" Click="Salir" />
            </MenuItem>
            <MenuItem Header="_Ver">
                <MenuItem Header="_Actualizar" InputGesture="F5" Click="Actualizar" />
            </MenuItem>
            <MenuItem Header="Ay_uda">
                <MenuItem Header="_Acerca de Nexo..." Click="AcercaDe" />
            </MenuItem>
        </Menu>

        <cc:ToolBar DockPanel.Dock="Top">
            <!-- Los iconos se ponen desde el codigo (Iconos.cs): ToolBarButton solo acepta Bitmap. -->
            <cc:ToolBarButton x:Name="BotonEscanear" Text="Escanear" Click="IrAEscaneo" />
            <cc:ToolBarButton x:Name="BotonLimpiar" Text="Limpiar" Click="IrALimpieza" />
            <cc:ToolBarButton x:Name="BotonFirewall" Text="Firewall" Click="IrAFirewall" />
            <cc:ToolBarButton x:Name="BotonCuarentena" Text="Cuarentena" Click="IrACuarentena" />
            <cc:ToolBarButton x:Name="BotonActualizar" Text="Actualizar" Click="Actualizar" />
        </cc:ToolBar>

        <cc:StatusBar DockPanel.Dock="Bottom">
            <cc:StatusBarItem cc:StatusBar.Size="3*"><TextBlock Text="{Binding BarraServicio}" /></cc:StatusBarItem>
            <cc:StatusBarItem cc:StatusBar.Size="2*"><TextBlock Text="{Binding BarraTiempoReal}" /></cc:StatusBarItem>
            <cc:StatusBarItem cc:StatusBar.Size="2*"><TextBlock Text="{Binding BarraMotor}" /></cc:StatusBarItem>
            <cc:StatusBarItem cc:StatusBar.Size="2*"><TextBlock Text="{Binding BarraConsulta}" /></cc:StatusBarItem>
        </cc:StatusBar>

        <TabControl x:Name="Pestanas" Margin="6">
            <TabItem Header="Estado">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10" Spacing="10">

                        <HeaderedContentControl Header="Estado general">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Top"
                                        Background="{Binding ColorDeEstado}" BorderBrush="Black" BorderThickness="1" />
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="TituloDeEstado" Text="{Binding Titulo}" FontWeight="Bold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Detalle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Módulos">
                            <Border Background="White" BorderBrush="#808080" BorderThickness="1">
                                <StackPanel>
                                    <Grid ColumnDefinitions="180,165,*" Background="#C0C0C0">
                                        <TextBlock Grid.Column="0" Margin="6,3" Text="Módulo" />
                                        <TextBlock Grid.Column="1" Margin="6,3" Text="Estado" />
                                        <TextBlock Grid.Column="2" Margin="6,3" Text="Detalle" />
                                    </Grid>
                                    <ItemsControl x:Name="ListaDeModulos" ItemsSource="{Binding Modulos}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:FilaVista">
                                                <Grid ColumnDefinitions="180,165,*">
                                                    <TextBlock Grid.Column="0" Margin="6,3" Text="{Binding Modulo}" />
                                                    <StackPanel Grid.Column="1" Margin="6,3" Orientation="Horizontal" Spacing="6">
                                                        <Border Width="10" Height="10" VerticalAlignment="Center"
                                                                Background="{Binding Color}" BorderBrush="Black" BorderThickness="1" />
                                                        <TextBlock Text="{Binding Estado}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Margin="6,3" Text="{Binding Detalle}" TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </HeaderedContentControl>

                        <TextBlock TextWrapping="Wrap" Foreground="#404040"
                                   Text="Nexo complementa a Microsoft Defender; no lo reemplaza. Detecta y avisa, pero no bloquea." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Escaneo">
                <ScrollViewer x:Name="PanelDeEscaneo" x:DataType="local:EscaneoModelo" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10" Spacing="10">

                        <Grid ColumnDefinitions="3*,10,2*">
                            <HeaderedContentControl Grid.Column="0" Header="Qué analizar">
                                <StackPanel Spacing="6">
                                    <RadioButton GroupName="destino" IsChecked="{Binding DestinoUsuario}" Content="{Binding TextoUsuario}" />
                                    <RadioButton GroupName="destino" IsChecked="{Binding DestinoDescargas}" Content="{Binding TextoDescargas}" />
                                    <RadioButton GroupName="destino" IsChecked="{Binding DestinoUnidad}" Content="{Binding TextoUnidad}" />
                                    <RadioButton GroupName="destino" IsChecked="{Binding DestinoOtra}" Content="Otra carpeta:" />
                                    <DockPanel Margin="20,0,0,0" IsEnabled="{Binding DestinoOtra}">
                                        <Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="Examinar..." Click="ElegirCarpeta" />
                                        <TextBox x:Name="CajaDeRuta" Text="{Binding RutaOtra}" FontFamily="Courier New,DejaVu Sans Mono,monospace" />
                                    </DockPanel>
                                </StackPanel>
                            </HeaderedContentControl>

                            <HeaderedContentControl Grid.Column="2" Header="Opciones">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8">
                                        <TextBlock VerticalAlignment="Center" Text="Archivos a la vez:" />
                                        <ComboBox ItemsSource="{Binding OpcionesDeParalelo}" SelectedItem="{Binding Paralelo}" MinWidth="60" />
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Top" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#404040"
                                               Text="El escaneo no modifica nada. Poner en cuarentena es una acción aparte." />
                                    <Button x:Name="BotonIniciar" DockPanel.Dock="Bottom" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,8,0,0"
                                            Content="Iniciar escaneo" IsDefault="True" IsEnabled="{Binding PuedeIniciar}" Click="IniciarEscaneo" />
                                </DockPanel>
                            </HeaderedContentControl>
                        </Grid>

                        <HeaderedContentControl Header="Progreso">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding TextoDeAvance}" />
                                <ProgressBar Height="18" IsIndeterminate="{Binding EnCurso}" Minimum="0" Maximum="1" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Cancelar escaneo" IsEnabled="{Binding PuedeCancelar}" Click="CancelarEscaneo" />
                                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#800000" Text="{Binding Mensaje}" />
                                </DockPanel>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Resultados">
                            <StackPanel Spacing="8">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Top"
                                            Background="{Binding Color}" BorderBrush="Black" BorderThickness="1" />
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="TituloDeEscaneo" Text="{Binding Titulo}" FontWeight="Bold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Detalle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>

                                <Border Background="White" BorderBrush="#808080" BorderThickness="1">
                                    <StackPanel>
                                        <Grid ColumnDefinitions="*,220,80" Background="#C0C0C0">
                                            <TextBlock Grid.Column="0" Margin="6,3" Text="Archivo" />
                                            <TextBlock Grid.Column="1" Margin="6,3" Text="Amenaza" />
                                            <TextBlock Grid.Column="2" Margin="6,3" Text="Tamaño" />
                                        </Grid>
                                        <ItemsControl x:Name="ListaDeDetecciones" ItemsSource="{Binding Detecciones}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:FilaDeDeteccion">
                                                    <Grid ColumnDefinitions="*,220,80">
                                                        <TextBlock Grid.Column="0" Margin="6,3" Text="{Binding Ruta}" TextWrapping="Wrap"
                                                                   FontFamily="Courier New,DejaVu Sans Mono,monospace" />
                                                        <TextBlock Grid.Column="1" Margin="6,3" Text="{Binding Firma}" TextWrapping="Wrap" Foreground="#C00000" />
                                                        <TextBlock Grid.Column="2" Margin="6,3" Text="{Binding Tamano}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <StackPanel Spacing="4" IsVisible="{Binding HayOmitidos}">
                                    <TextBlock Text="{Binding TextoOmitidos}" />
                                    <Border Background="White" BorderBrush="#808080" BorderThickness="1" MaxHeight="140">
                                        <ScrollViewer>
                                            <ItemsControl ItemsSource="{Binding Omitidos}" Margin="6,3">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontFamily="Courier New,DejaVu Sans Mono,monospace" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>

                                <DockPanel>
                                    <Button x:Name="BotonCuarentenaDeEscaneo" DockPanel.Dock="Right" Content="Poner en cuarentena..." FontWeight="Bold"
                                            IsEnabled="{Binding PuedePonerEnCuarentena}" Click="PonerEnCuarentena" />
                                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#404040"
                                               Text="Un archivo sin analizar nunca cuenta como limpio." />
                                </DockPanel>
                            </StackPanel>
                        </HeaderedContentControl>

                        <!-- Lo que encontró el escaneo programado (el servicio lo corre solo). Solo aparece si hay algo, o si no se pudo leer. -->
                        <HeaderedContentControl Header="Escaneo programado" IsVisible="{Binding HayProgramadas}">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="TextoDeProgramadas" Text="{Binding TextoProgramadas}" TextWrapping="Wrap" />
                                <Border Background="White" BorderBrush="#808080" BorderThickness="1">
                                    <ItemsControl x:Name="ListaDeProgramadas" ItemsSource="{Binding Programadas}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:FilaDeDeteccion">
                                                <Grid ColumnDefinitions="*,220,80">
                                                    <TextBlock Grid.Column="0" Margin="6,3" Text="{Binding Ruta}" TextWrapping="Wrap"
                                                               FontFamily="Courier New,DejaVu Sans Mono,monospace" />
                                                    <TextBlock Grid.Column="1" Margin="6,3" Text="{Binding Firma}" TextWrapping="Wrap" Foreground="#C00000" />
                                                    <TextBlock Grid.Column="2" Margin="6,3" Text="{Binding Tamano}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                                <Button x:Name="BotonCuarentenaProgramada" HorizontalAlignment="Right" Content="Poner en cuarentena..." FontWeight="Bold"
                                        IsEnabled="{Binding PuedePonerEnCuarentenaProgramadas}" Click="PonerEnCuarentenaLoProgramado" />
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Tiempo real">
                <ScrollViewer x:Name="PanelDeTiempoReal" x:DataType="local:TiempoRealModelo" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10" Spacing="10">

                        <HeaderedContentControl Header="Análisis en tiempo real">
                            <StackPanel Spacing="4">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Top"
                                            Background="{Binding Color}" BorderBrush="Black" BorderThickness="1" />
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="TituloDeTiempoReal" Text="{Binding Titulo}" FontWeight="Bold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Explicacion}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock x:Name="MotorDeTiempoReal" Text="{Binding Motor}" TextWrapping="Wrap" Margin="34,4,0,0" />
                                <TextBlock x:Name="ContadoresDeTiempoReal" Text="{Binding Contadores}" TextWrapping="Wrap" Margin="34,0,0,0" />
                                <TextBlock Text="{Binding UltimoAviso}" TextWrapping="Wrap" Margin="34,0,0,0"
                                           IsVisible="{Binding UltimoAviso, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <TextBlock Text="{Binding Nota}" TextWrapping="Wrap" Margin="34,0,0,0" Foreground="#404040" FontStyle="Italic" />
                            </StackPanel>
                        </HeaderedContentControl>

                        <Grid ColumnDefinitions="*,10,240">
                            <HeaderedContentControl Grid.Column="0" Header="Carpetas vigiladas">
                                <ItemsControl x:Name="ListaDeCarpetasVigiladas" ItemsSource="{Binding Carpetas}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:FilaDeCarpetaVigilada">
                                            <Grid ColumnDefinitions="110,*" Margin="0,1">
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                                    <Border Width="10" Height="10" VerticalAlignment="Center"
                                                            Background="{Binding Color}" BorderBrush="Black" BorderThickness="1" />
                                                    <TextBlock Text="{Binding Estado}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Ruta}" TextWrapping="Wrap"
                                                           FontFamily="Courier New,DejaVu Sans Mono,monospace" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </HeaderedContentControl>

                            <HeaderedContentControl Grid.Column="2" Header="Configuración">
                                <TextBlock TextWrapping="Wrap" Foreground="#404040"
                                           Text="Encenderlo, apagarlo y elegir las carpetas lo hace un administrador en appsettings.json del servicio. Esta ventana no puede cambiarlo, a propósito: así un programa malicioso tampoco puede apagar la protección." />
                            </HeaderedContentControl>
                        </Grid>

                        <HeaderedContentControl Header="Detecciones">
                            <StackPanel Spacing="8">
                                <Border Background="White" BorderBrush="#808080" BorderThickness="1" MinHeight="70">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,200,80,100" Background="#C0C0C0">
                                            <TextBlock Grid.Column="0" Margin="6,3" Text="Archivo" />
                                            <TextBlock Grid.Column="1" Margin="6,3" Text="Amenaza" />
                                            <TextBlock Grid.Column="2" Margin="6,3" Text="Tamaño" />
                                            <TextBlock Grid.Column="3" Margin="6,3" Text="Modificado" />
                                        </Grid>
                                        <ItemsControl x:Name="ListaDeDeteccionesEnTiempoReal" ItemsSource="{Binding Detecciones}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:FilaDeDeteccionEnTiempoReal">
                                                    <Grid ColumnDefinitions="*,200,80,100">
                                                        <TextBlock Grid.Column="0" Margin="6,1" Text="{Binding Ruta}" TextWrapping="Wrap"
                                                                   FontFamily="Courier New,DejaVu Sans Mono,monospace" />
                                                        <TextBlock Grid.Column="1" Margin="6,1" Text="{Binding Firma}" TextWrapping="Wrap" />
                                                        <TextBlock Grid.Column="2" Margin="6,1" Text="{Binding Tamano}" />
                                                        <TextBlock Grid.Column="3" Margin="6,1" Text="{Binding Cuando}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DockPanel>
                                </Border>
                                <DockPanel>
                                    <Button x:Name="BotonCuarentenaDeTiempoReal" DockPanel.Dock="Right" Content="Poner en cuarentena..." FontWeight="Bold"
                                            IsEnabled="{Binding PuedePonerEnCuarentena}" Click="PonerEnCuarentenaLoDelTiempoReal" />
                                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding TextoDetecciones}" />
                                </DockPanel>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Por revisar">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="TextoPorRevisar" Text="{Binding TextoPorRevisar}" TextWrapping="Wrap" />
                                <ItemsControl x:Name="ListaPorRevisar" ItemsSource="{Binding PorRevisar}" Margin="12,0,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontFamily="Courier New,DejaVu Sans Mono,monospace" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <DockPanel>
                                    <Button x:Name="BotonRevisar" DockPanel.Dock="Right" Content="Revisar lo que no se vio..."
                                            IsEnabled="{Binding PuedeRevisar}" Click="RevisarLoNoVisto" />
                                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#404040"
                                               Text="Revisar es un escaneo normal (solo lee) y se sigue en la pestaña «Escaneo»." />
                                </DockPanel>
                                <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap" Foreground="#800000" />
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Firewall">
                <ScrollViewer x:Name="PanelDeFirewall" x:DataType="local:FirewallModelo" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10" Spacing="10">

                        <Grid ColumnDefinitions="*,10,*">
                            <HeaderedContentControl Grid.Column="0" Header="Firewall de Windows">
                                <StackPanel Spacing="6">
                                    <TextBlock x:Name="ResumenDeFirewall" Text="{Binding Resumen}" TextWrapping="Wrap" />
                                    <ItemsControl x:Name="ListaDePerfiles" ItemsSource="{Binding Perfiles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:FilaDePerfil">
                                                <Grid ColumnDefinitions="80,110,*" Margin="0,1">
                                                    <TextBlock Grid.Column="0" Text="{Binding Perfil}" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                        <Border Width="10" Height="10" VerticalAlignment="Center"
                                                                Background="{Binding Color}" BorderBrush="Black" BorderThickness="1" />
                                                        <TextBlock Text="{Binding Estado}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding Entrada}" TextWrapping="Wrap" Foreground="#404040" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </HeaderedContentControl>

                            <HeaderedContentControl Grid.Column="2" Header="Modo sigiloso">
                                <DockPanel>
                                    <Button x:Name="BotonSigiloso" DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,8,0,0"
                                            Content="{Binding TextoBotonSigiloso}" IsEnabled="{Binding PuedeCambiarSigiloso}" Click="CambiarSigiloso" />
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="TextoDeSigiloso" Text="{Binding TextoSigiloso}" FontWeight="Bold" TextWrapping="Wrap" />
                                        <TextBlock TextWrapping="Wrap" Foreground="#404040"
                                                   Text="Windows ya ignora el resto del tráfico entrante no pedido; Nexo solo añade el bloqueo del ping." />
                                    </StackPanel>
                                </DockPanel>
                            </HeaderedContentControl>
                        </Grid>

                        <HeaderedContentControl Header="Reglas de Nexo">
                            <StackPanel Spacing="8">
                                <TextBlock TextWrapping="Wrap"
                                           Text="Nexo solo modifica las reglas de su propio grupo («Nexo Security Suite»). Nunca bloquea procesos del sistema, Microsoft Defender ni a sí mismo." />
                                <Border Background="White" BorderBrush="#808080" BorderThickness="1" MinHeight="90">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,80,80,80" Background="#C0C0C0">
                                            <TextBlock Grid.Column="0" Margin="6,3" Text="Programa" />
                                            <TextBlock Grid.Column="1" Margin="6,3" Text="Acción" />
                                            <TextBlock Grid.Column="2" Margin="6,3" Text="Dirección" />
                                            <TextBlock Grid.Column="3" Margin="6,3" Text="Habilitada" />
                                        </Grid>
                                        <ListBox x:Name="TablaDeReglas" ItemsSource="{Binding Reglas}" SelectedItem="{Binding Seleccionada}"
                                                 BorderThickness="0" Background="White">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="local:FilaDeRegla">
                                                    <Grid ColumnDefinitions="*,80,80,80">
                                                        <TextBlock Grid.Column="0" Margin="2,1" Text="{Binding Programa}" TextWrapping="Wrap"
                                                                   FontFamily="Courier New,DejaVu Sans Mono,monospace" />
                                                        <TextBlock Grid.Column="1" Margin="6,1" Text="{Binding Accion}" />
                                                        <TextBlock Grid.Column="2" Margin="6,1" Text="{Binding Direccion}" />
                                                        <TextBlock Grid.Column="3" Margin="6,1" Text="{Binding Habilitada}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </Border>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                                        <ComboBox ItemsSource="{Binding OpcionesDeDireccion}" SelectedIndex="{Binding DireccionElegida}" MinWidth="150" />
                                        <Button x:Name="BotonBloquear" Content="Bloquear programa..." FontWeight="Bold" IsEnabled="{Binding PuedeBloquear}" Click="BloquearPrograma" />
                                        <Button x:Name="BotonQuitarRegla" Content="Quitar regla..." IsEnabled="{Binding PuedeQuitar}" Click="QuitarRegla" />
                                        <Button Content="Actualizar" Click="ActualizarFirewall" />
                                    </StackPanel>
                                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#800000" Text="{Binding Mensaje}" />
                                </DockPanel>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Conexiones bloqueadas">
                            <TextBlock TextWrapping="Wrap"
                                       Text="Para ver qué conexiones se bloquearon hace falta activar la auditoría de Windows, y Nexo no la activa por su cuenta. Esta ventana todavía no las muestra: mientras tanto, use nexo-firewall bloqueos en la consola." />
                        </HeaderedContentControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Limpieza">
                <ScrollViewer x:Name="PanelDeLimpieza" x:DataType="local:LimpiezaModelo" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10" Spacing="10">

                        <HeaderedContentControl Header="1. Qué limpiar">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="TextoDeModo" Text="{Binding TextoModo}" FontWeight="Bold" TextWrapping="Wrap" />
                                <TextBlock IsVisible="{Binding ModoPermanente}" Foreground="#C00000" TextWrapping="Wrap"
                                           Text="Atención: el servicio está configurado para borrar de forma permanente. Lo borrado no irá a la Papelera." />
                                <Border Background="White" BorderBrush="#808080" BorderThickness="1" MaxHeight="190">
                                    <ScrollViewer>
                                        <ItemsControl x:Name="ListaDeReglasDeLimpieza" ItemsSource="{Binding Reglas}" Margin="6,3">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:FilaDeReglaDeLimpieza">
                                                    <CheckBox IsChecked="{Binding Marcada}" Margin="0,1">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding Nombre}" />
                                                            <TextBlock Text="{Binding Detalle}" Foreground="#606060" />
                                                        </StackPanel>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                                <DockPanel>
                                    <Button x:Name="BotonVistaPrevia" DockPanel.Dock="Right" Content="Vista previa" IsDefault="True"
                                            IsEnabled="{Binding PuedePrevisualizar}" Click="PrevisualizarLimpieza" />
                                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#404040"
                                               Text="Las de riesgo medio y alto vienen desmarcadas. Nexo solo borra lo que está en su catálogo." />
                                </DockPanel>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="2. Qué se encontró">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="TituloDeLimpieza" Text="{Binding TituloVista}" FontWeight="Bold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding DetalleVista}" TextWrapping="Wrap" />
                                <Border Background="White" BorderBrush="#808080" BorderThickness="1">
                                    <StackPanel>
                                        <Grid ColumnDefinitions="*,90,90" Background="#C0C0C0">
                                            <TextBlock Grid.Column="0" Margin="6,3" Text="Categoría" />
                                            <TextBlock Grid.Column="1" Margin="6,3" Text="Archivos" />
                                            <TextBlock Grid.Column="2" Margin="6,3" Text="Tamaño" />
                                        </Grid>
                                        <ItemsControl x:Name="ListaDeCategorias" ItemsSource="{Binding Categorias}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:FilaDeCategoria">
                                                    <Grid ColumnDefinitions="*,90,90">
                                                        <TextBlock Grid.Column="0" Margin="6,2" Text="{Binding Categoria}" />
                                                        <TextBlock Grid.Column="1" Margin="6,2" Text="{Binding Archivos}" />
                                                        <TextBlock Grid.Column="2" Margin="6,2" Text="{Binding Tamano}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Expander Header="Los archivos más grandes" HorizontalAlignment="Stretch">
                                    <ItemsControl ItemsSource="{Binding Ejemplos}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Text="{Binding}" FontFamily="Courier New,DejaVu Sans Mono,monospace" TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                                <Border IsVisible="{Binding HayAvisos}" Background="#FFFFE1" BorderBrush="#808080" BorderThickness="1" Padding="6,3" MaxHeight="120">
                                    <ScrollViewer>
                                        <ItemsControl ItemsSource="{Binding Avisos}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="3. Confirmar">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock VerticalAlignment="Center" Text="Para confirmar, escriba BORRAR:" />
                                    <TextBox x:Name="CajaDeConfirmacion" Text="{Binding Confirmacion}" Width="140"
                                             FontFamily="Courier New,DejaVu Sans Mono,monospace" IsEnabled="{Binding PuedeEscribirConfirmacion}" />
                                    <Button x:Name="BotonAplicarLimpieza" Content="{Binding TextoBotonLimpiar}" FontWeight="Bold"
                                            IsEnabled="{Binding PuedeLimpiar}" Click="Limpiar" />
                                </StackPanel>
                                <TextBlock x:Name="MensajeDeLimpieza" Text="{Binding Mensaje}" TextWrapping="Wrap" Foreground="#800000" />
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Disco">
                <ScrollViewer x:Name="PanelDeDisco" x:DataType="local:DiscoModelo" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10" Spacing="10">

                        <HeaderedContentControl Header="Salud de los discos">
                            <StackPanel Spacing="4">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Top"
                                            Background="{Binding Color}" BorderBrush="Black" BorderThickness="1" />
                                    <Button x:Name="BotonLeerDiscos" DockPanel.Dock="Right" VerticalAlignment="Top" Margin="10,0,0,0"
                                            Content="Volver a leer" IsEnabled="{Binding PuedeLeer}" Click="LeerDiscos" />
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="TituloDeDisco" Text="{Binding Titulo}" FontWeight="Bold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Explicacion}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Text="{Binding Lectura}" TextWrapping="Wrap" Margin="34,4,0,0" Foreground="#404040" />
                                <TextBlock Text="{Binding Advertencia}" TextWrapping="Wrap" Margin="34,0,0,0" Foreground="#800000"
                                           IsVisible="{Binding Advertencia, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap" Margin="34,0,0,0" Foreground="#800000"
                                           IsVisible="{Binding Mensaje, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Discos">
                            <Border Background="White" BorderBrush="#808080" BorderThickness="1" MinHeight="70">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,130,70,70,90" Background="#C0C0C0">
                                        <TextBlock Grid.Column="0" Margin="6,3" Text="Disco" />
                                        <TextBlock Grid.Column="1" Margin="6,3" Text="Estado" />
                                        <TextBlock Grid.Column="2" Margin="6,3" Text="Temp." />
                                        <TextBlock Grid.Column="3" Margin="6,3" Text="Desgaste" />
                                        <TextBlock Grid.Column="4" Margin="6,3" Text="Encendido" />
                                    </Grid>
                                    <ItemsControl x:Name="ListaDeDiscos" ItemsSource="{Binding Discos}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:FilaDeDisco">
                                                <StackPanel Margin="0,3,0,5" Spacing="2">
                                                    <Grid ColumnDefinitions="*,130,70,70,90">
                                                        <StackPanel Grid.Column="0" Margin="6,0" Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="{Binding Modelo}" FontWeight="Bold" />
                                                            <TextBlock Text="{Binding Serie}" Foreground="#404040" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="6,0" Orientation="Horizontal" Spacing="6">
                                                            <Border Width="10" Height="10" VerticalAlignment="Center"
                                                                    Background="{Binding Color}" BorderBrush="Black" BorderThickness="1" />
                                                            <TextBlock Text="{Binding Estado}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Margin="6,0" Text="{Binding Temperatura}" />
                                                        <TextBlock Grid.Column="3" Margin="6,0" Text="{Binding Desgaste}" />
                                                        <TextBlock Grid.Column="4" Margin="6,0" Text="{Binding Horas}" />
                                                    </Grid>
                                                    <TextBlock Margin="12,0,6,0" Text="{Binding Detalle}" TextWrapping="Wrap" />
                                                    <ItemsControl Margin="12,0,6,0" ItemsSource="{Binding Alertas}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="x:String">
                                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Margin="12,0,6,0" Text="{Binding Limitaciones}" TextWrapping="Wrap" Foreground="#404040"
                                                               IsVisible="{Binding HayLimitaciones}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                            </Border>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Qué se revisa">
                            <TextBlock TextWrapping="Wrap" Foreground="#404040"
                                       Text="La bandera de predicción de fallo del propio disco y los cinco atributos S.M.A.R.T. que, según los datos públicos de Backblaze, anticipan un fallo: sectores reasignados (05), errores incorregibles (187), tiempos de espera (188), sectores pendientes (197) e incorregibles fuera de línea (198). La temperatura, el desgaste y las horas se muestran, pero no se evalúan. El servicio lee los discos al arrancar y cada pocas horas (6 por omisión); solo lee, nunca escribe en ellos. Muchos discos NVMe, USB o tras una controladora RAID no exponen estos datos: entonces se dice «sin evaluar», no «bien»." />
                        </HeaderedContentControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Cuarentena">
                <DockPanel x:Name="PanelDeCuarentena" x:DataType="local:CuarentenaModelo" Margin="10">
                    <HeaderedContentControl Header="Archivos en cuarentena">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="Estos archivos se guardaron cifrados en una carpeta protegida: no se pueden ejecutar y ningún antivirus los vuelve a detectar. Pasados 30 días se pueden eliminar con «Eliminar vencidos...»; nada se borra solo." />

                            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                                    <Button x:Name="BotonRestaurar" Content="Restaurar..." IsEnabled="{Binding PuedeRestaurar}" Click="Restaurar" />
                                    <Button x:Name="BotonEliminarVencidos" Content="Eliminar vencidos..." IsEnabled="{Binding PuedeEliminarVencidos}" Click="EliminarVencidos" />
                                    <Button Content="Actualizar" Click="ActualizarCuarentena" />
                                </StackPanel>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="ResumenDeCuarentena" Text="{Binding Resumen}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap" Foreground="#800000" />
                                </StackPanel>
                            </DockPanel>

                            <Border Background="White" BorderBrush="#808080" BorderThickness="1">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,200,110,90" Background="#C0C0C0">
                                        <TextBlock Grid.Column="0" Margin="6,3" Text="Ubicación original" />
                                        <TextBlock Grid.Column="1" Margin="6,3" Text="Amenaza" />
                                        <TextBlock Grid.Column="2" Margin="6,3" Text="Desde" />
                                        <TextBlock Grid.Column="3" Margin="6,3" Text="Vence" />
                                    </Grid>
                                    <ListBox x:Name="TablaDeCuarentena" ItemsSource="{Binding Elementos}" SelectedItem="{Binding Seleccionado}"
                                             BorderThickness="0" Background="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="local:FilaDeCuarentena">
                                                <Grid ColumnDefinitions="*,200,110,90">
                                                    <!-- Una ruta larga sin espacios no se parte: se recorta con «…» (la ruta completa, en el tooltip) para no empujar las otras columnas. -->
                                                    <TextBlock Grid.Column="0" Margin="2,1" Text="{Binding Ruta}" TextTrimming="CharacterEllipsis"
                                                               ToolTip.Tip="{Binding Ruta}" FontFamily="Courier New,DejaVu Sans Mono,monospace" />
                                                    <TextBlock Grid.Column="1" Margin="6,1" Text="{Binding Firma}" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="2" Margin="6,1" Text="{Binding Desde}" />
                                                    <TextBlock Grid.Column="3" Margin="6,1" Text="{Binding Vence}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>
                        </DockPanel>
                    </HeaderedContentControl>
                </DockPanel>
            </TabItem>
            <TabItem Header="Seguridad">
                <ScrollViewer x:Name="PanelDeSeguridad" x:DataType="local:SeguridadModelo" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10" Spacing="10">

                        <HeaderedContentControl Header="Revisión de seguridad del equipo">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Top"
                                        Background="{Binding Color}" BorderBrush="Black" BorderThickness="1" />
                                <Button x:Name="BotonRevisarTodo" DockPanel.Dock="Right" VerticalAlignment="Top" Margin="10,0,0,0"
                                        Content="Revisar todo" IsEnabled="{Binding PuedeRevisarTodo}" Click="RevisarTodo" />
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="TituloDeSeguridad" Text="{Binding Titulo}" FontWeight="Bold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Explicacion}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </HeaderedContentControl>

                        <ItemsControl x:Name="ListaDeSecciones" ItemsSource="{Binding Secciones}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:FilaDeSeccion">
                                    <HeaderedContentControl Header="{Binding Nombre}" Margin="0,0,0,10">
                                        <StackPanel Spacing="4">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Top"
                                                        Background="{Binding Color}" BorderBrush="Black" BorderThickness="1" />
                                                <Button DockPanel.Dock="Right" VerticalAlignment="Top" Margin="10,0,0,0" Content="{Binding Boton}"
                                                        Tag="{Binding Seccion}" IsEnabled="{Binding PuedeRevisar}" Click="RevisarSeccion" />
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding Estado}" FontWeight="Bold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Resumen}" TextWrapping="Wrap" Foreground="#404040" />
                                                </StackPanel>
                                            </DockPanel>

                                            <Border Background="White" BorderBrush="#808080" BorderThickness="1" Margin="24,2,0,0"
                                                    IsVisible="{Binding HayHallazgos}">
                                                <ItemsControl ItemsSource="{Binding Hallazgos}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="local:FilaDeHallazgoVista">
                                                            <StackPanel Margin="6,4,6,6" Spacing="2">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <Border Width="10" Height="10" VerticalAlignment="Center"
                                                                            Background="{Binding Color}" BorderBrush="Black" BorderThickness="1" />
                                                                    <TextBlock Text="{Binding Gravedad}" FontWeight="Bold" />
                                                                    <TextBlock Text="{Binding Titulo}" FontWeight="Bold" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                                <TextBlock Margin="16,0,0,0" Text="{Binding Sujeto}" Foreground="#404040" TextWrapping="Wrap"
                                                                           IsVisible="{Binding TieneSujeto}" />
                                                                <TextBlock Margin="16,0,0,0" Text="{Binding Detalle}" TextWrapping="Wrap" />
                                                                <TextBlock Margin="16,0,0,0" Text="{Binding Recomendacion, StringFormat='Qué hacer: {0}'}" TextWrapping="Wrap" Foreground="#404040" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>

                                            <StackPanel Margin="24,2,0,0" Spacing="2" IsVisible="{Binding HayNoEvaluado}">
                                                <TextBlock Text="No se pudo revisar todo (esto NO significa que esté bien):" Foreground="#800000" FontWeight="Bold" TextWrapping="Wrap" />
                                                <ItemsControl ItemsSource="{Binding NoEvaluado}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Foreground="#800000" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </HeaderedContentControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <HeaderedContentControl Header="Qué se revisa">
                            <TextBlock TextWrapping="Wrap" Foreground="#404040"
                                       Text="Solo se lee: ninguna revisión cambia nada en el equipo. Cuentas: las cuentas locales, su política de contraseñas y el inicio de sesión automático; nunca se leen contraseñas ni hashes, y de la contraseña del inicio automático solo se mira si existe, no su valor. Wi-Fi: el tipo de seguridad de cada red guardada (abierta, WEP, TKIP) y de la conexión actual; nunca se pide la clave. Aplicaciones: usa winget, que consulta Internet, por eso solo se ejecuta cuando pulsas el botón; solo entiende winget en español, y solo conoce las aplicaciones que sabe identificar, así que no revisa todo el software instalado. Una versión más nueva no significa que la tuya sea vulnerable. Si algo no se puede revisar, se dice: nunca se muestra como «sin problemas»." />
                        </HeaderedContentControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Contraseñas">
                <ScrollViewer x:Name="PanelDeContrasenas" x:DataType="local:ContrasenasModelo" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10" Spacing="10">

                        <HeaderedContentControl Header="Bóveda de contraseñas">
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="TituloDeContrasenas" Text="{Binding Titulo}" FontWeight="Bold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Explicacion}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Archivo}" TextWrapping="Wrap" Foreground="#404040" />
                                <TextBlock x:Name="MensajeDeContrasenas" Text="{Binding Mensaje}" TextWrapping="Wrap" Foreground="#800000"
                                           IsVisible="{Binding Mensaje, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                        </HeaderedContentControl>

                        <!-- 1. Todavia no hay boveda: crearla. -->
                        <HeaderedContentControl x:Name="PanelSinBoveda" Header="Crear tu bóveda" IsVisible="{Binding EsSinBoveda}">
                            <StackPanel Spacing="6">
                                <TextBlock TextWrapping="Wrap" Foreground="#404040"
                                           Text="Elige una contraseña maestra larga (mínimo 10 caracteres). Es la única que tendrás que recordar. No hay forma de recuperarla: si la olvidas, lo que guardes aquí se pierde." />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Contraseña maestra:" Width="150" VerticalAlignment="Center" />
                                    <TextBox x:Name="CajaMaestraNueva" PasswordChar="•" Width="300" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Repítela:" Width="150" VerticalAlignment="Center" />
                                    <TextBox x:Name="CajaMaestraRepetida" PasswordChar="•" Width="300" />
                                </StackPanel>
                                <Button x:Name="BotonCrearBoveda" Content="Crear bóveda" HorizontalAlignment="Left" IsEnabled="{Binding NoOcupado}" Click="CrearBoveda" />
                            </StackPanel>
                        </HeaderedContentControl>

                        <!-- 2. Hay boveda pero esta cerrada. -->
                        <HeaderedContentControl x:Name="PanelBloqueada" Header="Desbloquear" IsVisible="{Binding EsBloqueada}">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Contraseña maestra:" VerticalAlignment="Center" />
                                    <TextBox x:Name="CajaMaestra" PasswordChar="•" Width="300" KeyDown="TeclaEnCajaMaestra" />
                                    <Button x:Name="BotonDesbloquear" Content="Desbloquear" IsEnabled="{Binding NoOcupado}" Click="DesbloquearBoveda" />
                                </StackPanel>
                                <TextBlock TextWrapping="Wrap" Foreground="#404040"
                                           Text="Abrir la bóveda tarda una fracción de segundo a propósito: es lo que hace costoso adivinar la contraseña." />
                            </StackPanel>
                        </HeaderedContentControl>

                        <!-- Restaurar una copia: solo con la boveda cerrada o sin boveda. -->
                        <HeaderedContentControl x:Name="PanelDeRestauracion" Header="Restaurar desde una copia" IsVisible="{Binding PuedeRestaurar}">
                            <StackPanel Spacing="6">
                                <TextBlock TextWrapping="Wrap" Foreground="#404040"
                                           Text="Si tienes una copia de seguridad, escribe aquí su contraseña maestra y elige el archivo. Antes de instalarla se comprueba que se abre; si ya tienes una bóveda, NO se borra: se guarda aparte con la fecha y la hora." />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Contraseña de la copia:" Width="150" VerticalAlignment="Center" />
                                    <TextBox x:Name="CajaMaestraDeCopia" PasswordChar="•" Width="300" />
                                    <Button x:Name="BotonRestaurarCopia" Content="Elegir copia y restaurar..." IsEnabled="{Binding NoOcupado}" Click="RestaurarCopia" />
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>

                        <!-- 3. Abierta. -->
                        <StackPanel x:Name="PanelAbierta" Spacing="10" IsVisible="{Binding EsAbierta}">

                            <HeaderedContentControl Header="Entradas">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                                            <Button x:Name="BotonNuevaEntrada" Content="Nueva..." IsEnabled="{Binding NoOcupado}" Click="NuevaEntrada" />
                                            <Button x:Name="BotonAuditar" Content="Comprobar filtraciones" IsEnabled="{Binding NoOcupado}" Click="AuditarBoveda" />
                                            <Button x:Name="BotonBloquearBoveda" Content="Bloquear" Click="BloquearBoveda" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="Buscar:" VerticalAlignment="Center" />
                                            <TextBox x:Name="CajaDeBusqueda" Width="220" Text="{Binding Filtro, Mode=TwoWay}" />
                                        </StackPanel>
                                    </DockPanel>

                                    <Border Background="White" BorderBrush="#808080" BorderThickness="1" MinHeight="120" MaxHeight="260">
                                        <DockPanel>
                                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,*,200" Background="#C0C0C0">
                                                <TextBlock Grid.Column="0" Margin="6,3" Text="Sitio" />
                                                <TextBlock Grid.Column="1" Margin="6,3" Text="Usuario" />
                                                <TextBlock Grid.Column="2" Margin="6,3" Text="Filtraciones" />
                                            </Grid>
                                            <ListBox x:Name="ListaDeEntradas" ItemsSource="{Binding Entradas}" SelectedItem="{Binding Seleccionada, Mode=TwoWay}"
                                                     BorderThickness="0" Background="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="local:FilaDeEntrada">
                                                        <Grid ColumnDefinitions="*,*,200">
                                                            <TextBlock Grid.Column="0" Margin="2,1" Text="{Binding Sitio}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="1" Margin="6,1" Text="{Binding Usuario}" TextTrimming="CharacterEllipsis" />
                                                            <StackPanel Grid.Column="2" Margin="6,1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding TieneFiltracion}">
                                                                <Border Width="10" Height="10" VerticalAlignment="Center" Background="{Binding Color}" BorderBrush="Black" BorderThickness="1" />
                                                                <TextBlock Text="{Binding Filtracion}" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </DockPanel>
                                    </Border>
                                </DockPanel>
                            </HeaderedContentControl>

                            <HeaderedContentControl x:Name="PanelDeAuditoria" Header="Filtraciones" IsVisible="{Binding HayAuditoria}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="16" Height="16" VerticalAlignment="Top" Background="{Binding ColorDeAuditoria}" BorderBrush="Black" BorderThickness="1" />
                                    <TextBlock x:Name="ResumenDeAuditoria" Text="{Binding Auditoria}" TextWrapping="Wrap" />
                                </StackPanel>
                            </HeaderedContentControl>

                            <!-- Detalle de la entrada elegida -->
                            <HeaderedContentControl x:Name="PanelDeDetalle" Header="Entrada elegida" IsVisible="{Binding DetalleVisible}">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="6" RowSpacing="3">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Sitio:" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DetalleSitio}" FontWeight="Bold" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Usuario:" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DetalleUsuario}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Contraseña:" />
                                        <TextBlock x:Name="TextoDeContrasena" Grid.Row="2" Grid.Column="1" Text="{Binding DetalleContrasena}" TextWrapping="Wrap"
                                                   FontFamily="Courier New,DejaVu Sans Mono,monospace" />
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Notas:" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DetalleNotas}" TextWrapping="Wrap" />
                                    </Grid>
                                    <TextBlock Text="{Binding DetalleFechas}" Foreground="#404040" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button x:Name="BotonMostrarContrasena" Content="{Binding BotonMostrar}" Click="AlternarContrasena" />
                                        <Button x:Name="BotonCopiarUsuario" Content="Copiar usuario" Click="CopiarUsuario" />
                                        <Button x:Name="BotonCopiarContrasena" Content="Copiar contraseña" Click="CopiarContrasena" />
                                        <Button x:Name="BotonCopiarCodigo2fa" Content="Copiar código 2FA" IsVisible="{Binding HayTotp}" Click="CopiarCodigoTotp" />
                                        <Button x:Name="BotonEditarEntrada" Content="Editar..." IsEnabled="{Binding NoOcupado}" Click="EditarEntrada" />
                                        <Button x:Name="BotonEliminarEntrada" Content="Eliminar..." IsEnabled="{Binding NoOcupado}" Click="EliminarEntrada" />
                                    </StackPanel>
                                    <TextBlock Foreground="#404040" TextWrapping="Wrap"
                                               Text="Al copiar una contraseña, se borra sola del portapapeles a los 30 segundos (si no copiaste otra cosa mientras tanto)." />
                                </StackPanel>
                            </HeaderedContentControl>

                            <!-- Formulario de alta y edicion -->
                            <HeaderedContentControl x:Name="PanelDeEdicion" Header="{Binding EdicionTitulo}" IsVisible="{Binding EdicionVisible}">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6" RowSpacing="6">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Sitio:" VerticalAlignment="Center" />
                                        <TextBox x:Name="CajaDeSitio" Grid.Row="0" Grid.Column="1" Text="{Binding EdSitio, Mode=TwoWay}" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Usuario:" VerticalAlignment="Center" />
                                        <TextBox x:Name="CajaDeUsuario" Grid.Row="1" Grid.Column="1" Text="{Binding EdUsuario, Mode=TwoWay}" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Contraseña:" VerticalAlignment="Center" />
                                        <DockPanel Grid.Row="2" Grid.Column="1">
                                            <Button x:Name="BotonGenerar" DockPanel.Dock="Right" Margin="6,0,0,0" Content="Generar" Click="GenerarContrasena" />
                                            <Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="{Binding BotonMostrar}" Click="AlternarContrasena" />
                                            <TextBox x:Name="CajaDeContrasena" Text="{Binding EdContrasena, Mode=TwoWay}" PasswordChar="{Binding CaracterDeClave}"
                                                     FontFamily="Courier New,DejaVu Sans Mono,monospace" />
                                        </DockPanel>
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Clave 2FA:" VerticalAlignment="Center" />
                                        <TextBox x:Name="CajaDeTotp" Grid.Row="4" Grid.Column="1" Text="{Binding EdTotp, Mode=TwoWay}" PasswordChar="{Binding CaracterDeClave}" Watermark="Opcional: la clave que da el sitio, o su enlace otpauth://"
                                                 FontFamily="Courier New,DejaVu Sans Mono,monospace" />
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Notas:" VerticalAlignment="Top" />
                                        <TextBox x:Name="CajaDeNotas" Grid.Row="3" Grid.Column="1" Text="{Binding EdNotas, Mode=TwoWay}" AcceptsReturn="True" Height="60" TextWrapping="Wrap" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button x:Name="BotonGuardarEntrada" Content="Guardar" IsEnabled="{Binding NoOcupado}" Click="GuardarEntrada" />
                                        <Button Content="Cancelar" Click="CancelarEntrada" />
                                    </StackPanel>
                                </StackPanel>
                            </HeaderedContentControl>

                            <HeaderedContentControl x:Name="PanelDeCopia" Header="Copia de seguridad">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="La bóveda es UN solo archivo: si se pierde o se daña, se pierde todo lo que guardaste. Guarda una copia cifrada, mejor en otro disco o en un USB." TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button x:Name="BotonGuardarCopia" Content="Guardar copia..." IsEnabled="{Binding NoOcupado}" Click="GuardarCopia" />
                                        <TextBlock x:Name="TextoDeCopiaGuardada" Text="{Binding TextoDeCopia}" VerticalAlignment="Center" Foreground="#404040" />
                                    </StackPanel>
                                    <TextBlock TextWrapping="Wrap" Foreground="#404040"
                                               Text="La copia se abre con tu contraseña maestra actual y contiene lo que hay AHORA: si después borras una entrada, seguirá en la copia que ya hiciste. Cuida las copias como cuidas la bóveda." />
                                </StackPanel>
                            </HeaderedContentControl>

                            <Expander Header="Cambiar la contraseña maestra" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="6" Margin="10">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Contraseña actual:" Width="150" VerticalAlignment="Center" />
                                        <TextBox x:Name="CajaMaestraActual" PasswordChar="•" Width="300" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Contraseña nueva:" Width="150" VerticalAlignment="Center" />
                                        <TextBox x:Name="CajaMaestraNuevaCambio" PasswordChar="•" Width="300" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Repite la nueva:" Width="150" VerticalAlignment="Center" />
                                        <TextBox x:Name="CajaMaestraRepetidaCambio" PasswordChar="•" Width="300" />
                                    </StackPanel>
                                    <Button x:Name="BotonCambiarMaestra" Margin="156,0,0,0" Content="Cambiar" HorizontalAlignment="Left" IsEnabled="{Binding NoOcupado}" Click="CambiarMaestra" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>

                        <HeaderedContentControl Header="Qué hay que saber">
                            <TextBlock TextWrapping="Wrap" Foreground="#404040"
                                       Text="La bóveda es un archivo cifrado en tu perfil de usuario (AES-256-GCM, con la clave derivada de tu contraseña maestra con Argon2id). Todo ocurre en este equipo, con tu usuario: no pasa por el servicio de Nexo. Se bloquea sola tras 5 minutos sin usarla y al cerrar la ventana. «Comprobar filtraciones» consulta Pwned Passwords (gratuito, sin cuenta) y solo envía los 5 primeros caracteres del hash de cada contraseña, nunca la contraseña; que una contraseña no aparezca no significa que sea fuerte. Limitación: los textos en memoria de un programa .NET no se pueden borrar a voluntad, así que lo que sí se borra al bloquear es la clave de cifrado." />
                        </HeaderedContentControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Enlaces">
                <ScrollViewer x:Name="PanelDeEnlaces" x:DataType="local:EnlacesModelo" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10" Spacing="10">

                        <HeaderedContentControl Header="¿Es una estafa? Pega el mensaje o el enlace">
                            <StackPanel Spacing="6">
                                <TextBox x:Name="CajaDeMensaje" Text="{Binding Texto}" AcceptsReturn="True" TextWrapping="Wrap"
                                         MinHeight="90" MaxHeight="220" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button x:Name="BotonRevisarEnlaces" Content="Revisar" IsEnabled="{Binding PuedeRevisar}" Click="RevisarEnlaces" />
                                    <Button x:Name="BotonBorrarMensaje" Content="Borrar" Click="BorrarMensaje" />
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Resultado">
                            <StackPanel Spacing="6">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Top"
                                            Background="{Binding Color}" BorderBrush="Black" BorderThickness="1" />
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="TituloDeEnlaces" Text="{Binding Titulo}" FontWeight="Bold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Explicacion}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>

                                <ItemsControl ItemsSource="{Binding HallazgosDelMensaje}" IsVisible="{Binding HayHallazgosDelMensaje}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:FilaDeHallazgoVista">
                                            <StackPanel Margin="34,2,0,4" Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Border Width="10" Height="10" VerticalAlignment="Center" Background="{Binding Color}" BorderBrush="Black" BorderThickness="1" />
                                                    <TextBlock Text="{Binding Gravedad}" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding Titulo}" FontWeight="Bold" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBlock Margin="16,0,0,0" Text="{Binding Detalle}" TextWrapping="Wrap" />
                                                <TextBlock Margin="16,0,0,0" Text="{Binding Recomendacion, StringFormat='Qué hacer: {0}'}" TextWrapping="Wrap" Foreground="#404040" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl x:Name="ListaDeEnlaces" ItemsSource="{Binding Enlaces}" IsVisible="{Binding HayEnlaces}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:FilaDeEnlaceVista">
                                            <Border Background="White" BorderBrush="#808080" BorderThickness="1" Margin="34,2,0,6">
                                                <StackPanel Margin="6,4,6,6" Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Border Width="12" Height="12" VerticalAlignment="Center" Background="{Binding Color}" BorderBrush="Black" BorderThickness="1" />
                                                        <TextBlock Text="{Binding Veredicto}" FontWeight="Bold" />
                                                        <TextBlock Text="{Binding Sitio}" FontFamily="Courier New,DejaVu Sans Mono,monospace" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <TextBlock Margin="18,0,0,0" Text="{Binding Original, StringFormat='Enlace: {0}'}" Foreground="#404040" TextWrapping="Wrap"
                                                               FontFamily="Courier New,DejaVu Sans Mono,monospace" IsVisible="{Binding MostrarOriginal}" />
                                                    <ItemsControl ItemsSource="{Binding Hallazgos}" IsVisible="{Binding HayHallazgos}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="local:FilaDeHallazgoVista">
                                                                <StackPanel Margin="18,4,0,0" Spacing="2">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <Border Width="10" Height="10" VerticalAlignment="Center" Background="{Binding Color}" BorderBrush="Black" BorderThickness="1" />
                                                                        <TextBlock Text="{Binding Gravedad}" FontWeight="Bold" />
                                                                        <TextBlock Text="{Binding Titulo}" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                    <TextBlock Margin="16,0,0,0" Text="{Binding Detalle}" TextWrapping="Wrap" />
                                                                    <TextBlock Margin="16,0,0,0" Text="{Binding Recomendacion, StringFormat='Qué hacer: {0}'}" TextWrapping="Wrap" Foreground="#404040" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Margin="34,2,0,0" Spacing="2" IsVisible="{Binding HayNoEvaluado}">
                                    <TextBlock Text="No se pudo comprobar todo (esto NO significa que esté bien):" Foreground="#800000" FontWeight="Bold" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding NoEvaluado}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Foreground="#800000" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Listas de phishing">
                            <DockPanel>
                                <Button x:Name="BotonActualizarListas" DockPanel.Dock="Right" VerticalAlignment="Top" Margin="10,0,0,0"
                                        Content="Actualizar listas" IsEnabled="{Binding PuedeActualizar}" Click="ActualizarListas" />
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="EstadoDeListas" Text="{Binding EstadoDeListas}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding MensajeDeActualizacion}" TextWrapping="Wrap" Foreground="#404040" IsVisible="{Binding HayMensajeDeActualizacion}" />
                                </StackPanel>
                            </DockPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Header="Qué hay que saber">
                            <TextBlock TextWrapping="Wrap" Foreground="#404040"
                                       Text="Nexo nunca abre el enlace ni pregunta a ningún servidor por él: lo compara en tu equipo con dos listas públicas de phishing (Phishing Army y OpenPhish, gratuitas) y con reglas propias (sitios que imitan a bancos y tiendas, letras de otro alfabeto, una «@» que esconde el sitio real, enlaces acortados, números en vez de nombre). El texto que pegas no se guarda ni sale del equipo. Solo «Actualizar listas» usa Internet, y solo para bajar las listas enteras. Límites: un sitio de phishing nuevo tarda horas o días en entrar en las listas, así que «sin señales» no significa «seguro»; las frases de estafa solo se reconocen en español; la lista de marcas es corta y no exhaustiva; y Nexo no analiza audio ni video (no detecta deepfakes ni llamadas falsas)." />
                        </HeaderedContentControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</classic:ClassicWindow>
