<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Nexo.Ui.Movil.PantallaEstado">
    <ScrollViewer>
        <StackPanel Margin="8" Spacing="6">
            <TextBlock Name="Resumen" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
            <StackPanel Name="Filas" Spacing="4" />
            <TextBlock Text="Secciones" FontSize="18" FontWeight="Bold" Margin="0,16,0,0" />
            <Button Name="IrApps" Content="Apps instaladas" MinHeight="48" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,0" />
            <Button Name="IrPruebas" Content="Pruebas (Argon2id)" MinHeight="48" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
