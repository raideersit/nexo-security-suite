<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Nexo.Ui.Movil.PantallaEstado">
    <ScrollViewer>
        <StackPanel Margin="8" Spacing="6">
            <TextBlock Name="Resumen" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
            <StackPanel Name="Filas" Spacing="4" />
            <Button Name="AbrirPlayStore" Content="Abrir Play Store (para revisar Play Protect)" MinHeight="48" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,0" />
            <TextBlock Text="Avisos" FontSize="18" FontWeight="Bold" Margin="0,16,0,0" />
            <CheckBox Name="AvisarAlInstalar" Content="Avisar cuando se instale o actualice una app" MinHeight="48" />
            <TextBlock Name="EstadoVigilancia" TextWrapping="Wrap" />
            <Button Name="AhorroDeBateria" Content="Abrir ajustes de ahorro de batería" MinHeight="48" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,0" IsVisible="False" />
            <TextBlock Text="Historial para Obsidian" FontSize="18" FontWeight="Bold" Margin="0,16,0,0" />
            <CheckBox Name="HistorialObsidian" Content="Guardar un historial en la carpeta Documents/Nexo" MinHeight="48" />
            <TextBlock Name="EstadoHistorial" TextWrapping="Wrap" />
            <Button Name="GuardarChequeo" Content="Guardar el chequeo del equipo ahora" MinHeight="48" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,0" IsVisible="False" />
            <TextBlock Text="Secciones" FontSize="18" FontWeight="Bold" Margin="0,16,0,0" />
            <Button Name="IrApps" Content="Apps instaladas" MinHeight="48" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,0" />
            <Button Name="IrPruebas" Content="Pruebas (Argon2id)" MinHeight="48" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
