<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Nexo.Ui.Movil.PantallaPrincipal">
    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top" Text="Nexo Security Suite" FontSize="22" FontWeight="Bold" Margin="0,24,0,8" />
        <TextBlock DockPanel.Dock="Top" Name="Resumen" TextWrapping="Wrap" Margin="0,0,0,8" />
        <Button DockPanel.Dock="Top" Name="Releer" Content="Volver a leer las apps" MinHeight="48" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
        <Button DockPanel.Dock="Top" Name="MedirArgon" Content="Medir Argon2id" MinHeight="48" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
        <TextBlock DockPanel.Dock="Top" Name="ResultadoArgon" TextWrapping="Wrap" Margin="0,0,0,8" />
        <ScrollViewer>
            <TextBlock Name="Lista" TextWrapping="Wrap" />
        </ScrollViewer>
    </DockPanel>
</UserControl>
