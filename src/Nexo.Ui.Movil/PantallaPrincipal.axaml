<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Nexo.Ui.Movil.PantallaPrincipal">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="8,28,8,8" Background="#000080">
            <DockPanel>
                <Button DockPanel.Dock="Left" Name="Atras" Content="&lt; Atras" MinHeight="48" MinWidth="88" Margin="0,0,8,0" />
                <TextBlock Name="Titulo" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>
        <ContentControl Name="Contenido" />
    </DockPanel>
</UserControl>
