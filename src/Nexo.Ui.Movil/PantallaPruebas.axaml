<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Nexo.Ui.Movil.PantallaPruebas">
    <ScrollViewer><StackPanel Margin="8" Spacing="8">
        <Button Name="MedirArgon" Content="Medir Argon2id" MinHeight="48" HorizontalAlignment="Stretch" />
        <TextBlock Name="ResultadoArgon" TextWrapping="Wrap" />
        <Button Name="Verificar" Content="Verificar APIs (por verificar)" MinHeight="48" HorizontalAlignment="Stretch" />
        <TextBlock Name="ResultadoSondas" TextWrapping="Wrap" />
    </StackPanel></ScrollViewer>
</UserControl>
